[Unit]
Description=AgentOS FastAPI runtime
After=network.target

[Service]
Type=simple
User=agentos
Group=agentos
WorkingDirectory=/opt/agentos/backend
EnvironmentFile=/opt/agentos/.env
Environment=PYTHONHASHSEED=42
Environment=AGENTOS_SEED=42
ExecStart=/opt/agentos/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/agentos/experiments

[Install]
WantedBy=multi-user.target
