AGENTOS_LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT=120

# Day 3 scheduler/runtime configuration
AGENTOS_SCHEDULER=fifo
AGENTOS_MODEL_TIER=1.5b
AGENTOS_MAX_CONCURRENCY=1

# Day 4 policy enforcement; set to off only for the Day 6 ablation experiment
AGENTOS_POLICY_ENFORCEMENT=on
